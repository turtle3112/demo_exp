RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(ruou-vang|ruou-manh|bia-ngoai|ly-pha-le|san-pham-khac|kien-thuc|nha-san-xuat|gioi-thieu|lien-he|chinh-sach|quatangdoanhnghiep|gio-hang|thanh-toan|tai-khoan|dang-nhap|dang-ky|ruou-vang-do|ruou-vang-trang|ruou-vang-hong|ruou-vang-ngot|ruou-vang-sui|ruou-vang-moscato|ruou-vang-phap|ruou-vang-y|ruou-vang-chile|ruou-vang-uc|ruou-vang-my|ruou-vang-tay-ban-nha|ruou-vang-bo-dao-nha|ruou-vang-duc|ruou-vang-ao|ruou-vang-nam-phi|ruou-vang-bordeaux|ruou-vang-bourgogne|ruou-vang-chianti|ruou-vang-barolo|ruou-whisky|ruou-cognac|ruou-brandy|ruou-gin|ruou-vodka|ruou-rum|ruou-tequila|ruou-whisky-scotch|ruou-whisky-american|ruou-whisky-japanese|ruou-whisky-irish|ruou-cognac-xo|ruou-cognac-vsop|bia-duc|bia-ba-lan|bia-bi|bia-hoa-lan|bia-bao|bia-phap|bia-tieng-sec|ly-pha-le-roma|ly-pha-le-paris|qua-tang-ruou|hop-qua-ruou|qua-tang-doanh-nghiep|kien-thuc-ruou|kien-thuc-ruou-vang)(/|$)
RewriteRule ^([a-z0-9-]+)$ sp1.php?slug=$1 [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)$ product_main.php?category_slug=$1 [QSA,L]
RewriteRule ^danh-muc/([0-9]+)$ product_main.php?cat_id=$1 [QSA,L]
RewriteRule ^ruou-vang/page/([0-9]+)$ product_main.php?product_type=1&page=$1 [QSA,L]
RewriteRule ^ruou-manh/page/([0-9]+)$ product_main.php?product_type=2&page=$1 [QSA,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^sp1\.php$ /%1? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)&type=wine(&|$)
RewriteRule ^sp1\.php$ /%1? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)&type=strong(&|$)
RewriteRule ^sp1\.php$ /%1? [R=301,L]
RewriteCond %{QUERY_STRING} ^product_type=1(&|$)
RewriteRule ^product_main\.php$ /ruou-vang? [R=301,L]
RewriteCond %{QUERY_STRING} ^product_type=2(&|$)
RewriteRule ^product_main\.php$ /ruou-manh? [R=301,L]
RewriteCond %{QUERY_STRING} ^cat_id=([0-9]+)(&|$)
RewriteRule ^product_main\.php$ /danh-muc/%1? [R=301,L]
RewriteRule ^product_main\.php$ /ruou-vang? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^lyphale\.php$ /ly-pha-le/%1? [R=301,L]
RewriteRule ^lyphale\.php$ /ly-pha-le? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^sp2\.php$ /ly-pha-le/%1? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^kienthuc\.php$ /kien-thuc/%1? [R=301,L]
RewriteRule ^kienthuc\.php$ /kien-thuc? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^sanphamkhac\.php$ /san-pham-khac/%1? [R=301,L]
RewriteRule ^sanphamkhac\.php$ /san-pham-khac? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^nhasanxuat\.php$ /nha-san-xuat/%1? [R=301,L]
RewriteRule ^sp1\.php$ /ruou-vang? [R=301,L]
ErrorDocument 404 /404.php