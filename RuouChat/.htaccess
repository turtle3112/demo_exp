RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^sitemap\.xml\.gz$ sitemap.php [L]
RewriteRule ^(admin|api|assets|uploads|css|js|images|fonts|vendor)/ - [L,NC]
RewriteRule \.(html|css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|xml|json|pdf)$ - [L,NC]
RewriteRule ^(index|sp1|sp2|product_main|lyphale|sanphamkhac|kienthuc|kienthuc1|cart|checkout|account|login|register|lienhe|chinh-sach|quatangdoanhnghiep|nhasanxuat|page|sp_other|category_form|post|404|sitemap)\.php$ - [L,NC]
