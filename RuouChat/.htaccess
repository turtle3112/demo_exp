RewriteRule ^ruou-vang/([a-z0-9-]+)$ sp1.php?slug=$1&type=wine [QSA,L]
RewriteRule ^ruou-manh/([a-z0-9-]+)$ sp1.php?slug=$1&type=strong [QSA,L]
RewriteRule ^ly-pha-le/([a-z0-9-]+)$ sp2.php?slug=$1 [QSA,L]
RewriteRule ^san-pham-khac/([a-z0-9-]+)$ sp_other.php?slug=$1 [QSA,L]
RewriteRule ^kien-thuc/([a-z0-9-]+)$ kienthuc1.php?slug=$1 [QSA,L]
